#!/bin/bash
# Toggle between light and dark themes for alacritty + tmux + neovim
# 和紙 (washi) — warm Japanese paper palette for light mode
# 墨 (sumi) — ink palette for dark mode
#
# Usage: theme-toggle [light|dark]
#   No argument = toggle current mode
#   light/dark  = set explicitly

# Resolve symlinks so sed -i '' works (macOS sed refuses to edit symlinks)
ALACRITTY_CONF=$(readlink -f "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || echo "$HOME/.config/alacritty/alacritty.toml")
TMUX_CONF=$(readlink -f "$HOME/.config/tmux/tmux.conf" 2>/dev/null || echo "$HOME/.config/tmux/tmux.conf")
PI_SETTINGS="$HOME/.pi/agent/settings.json"
STATE_FILE="$HOME/.config/theme-mode"

# --- Alacritty themes ---
DARK_ALACRITTY="kanagawa_dragon"
LIGHT_ALACRITTY="washi"

# --- Palettes ---
# Dark (墨 sumi)
DARK_BG="#1a1a1a"
DARK_FG="#a0a0a0"
DARK_ACCENT="#6e6e6e"
DARK_ACTIVE="#d4d4d4"
DARK_MUTED="#4a4a4a"
DARK_BAR="#252525"

# Light (和紙 washi)
LIGHT_BG="#f0f0ee"
LIGHT_FG="#1a1816"
LIGHT_ACCENT="#7a8279"
LIGHT_ACTIVE="#1a1816"
LIGHT_MUTED="#c0bdb8"
LIGHT_BAR="#e6e5e2"

# Determine current mode
current=$(cat "$STATE_FILE" 2>/dev/null || echo "dark")

if [ -n "$1" ]; then
    target="$1"
else
    if [ "$current" = "dark" ]; then
        target="light"
    else
        target="dark"
    fi
fi

if [ "$target" = "light" ]; then
    alacritty_theme="$LIGHT_ALACRITTY"
    washi_bg="$LIGHT_BG"
    washi_fg="$LIGHT_FG"
    washi_accent="$LIGHT_ACCENT"
    washi_active="$LIGHT_ACTIVE"
    washi_muted="$LIGHT_MUTED"
    washi_bar="$LIGHT_BAR"
else
    alacritty_theme="$DARK_ALACRITTY"
    washi_bg="$DARK_BG"
    washi_fg="$DARK_FG"
    washi_accent="$DARK_ACCENT"
    washi_active="$DARK_ACTIVE"
    washi_muted="$DARK_MUTED"
    washi_bar="$DARK_BAR"
fi

# Update alacritty (live reload on file change)
# Light uses custom themes/washi.toml, dark uses cloned themes/themes/kanagawa_dragon.toml
if [ "$target" = "light" ]; then
    sed -i '' 's|themes/[^"]*\.toml|themes/washi.toml|' "$ALACRITTY_CONF"
else
    sed -i '' 's|themes/[^"]*\.toml|themes/themes/kanagawa_dragon.toml|' "$ALACRITTY_CONF"
fi

# Touch the symlink path to trigger Alacritty's file watcher
touch -h "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null

# Update tmux washi colors
sed -i '' "s/WASHI_BG=\".*\"/WASHI_BG=\"${washi_bg}\"/" "$TMUX_CONF"
sed -i '' "s/WASHI_FG=\".*\"/WASHI_FG=\"${washi_fg}\"/" "$TMUX_CONF"
sed -i '' "s/WASHI_ACCENT=\".*\"/WASHI_ACCENT=\"${washi_accent}\"/" "$TMUX_CONF"
sed -i '' "s/WASHI_ACTIVE=\".*\"/WASHI_ACTIVE=\"${washi_active}\"/" "$TMUX_CONF"
sed -i '' "s/WASHI_MUTED=\".*\"/WASHI_MUTED=\"${washi_muted}\"/" "$TMUX_CONF"
sed -i '' "s/WASHI_BAR=\".*\"/WASHI_BAR=\"${washi_bar}\"/" "$TMUX_CONF"

# Live-reload tmux if running
if [ -n "$TMUX" ] || tmux list-sessions &>/dev/null; then
    tmux source-file "$TMUX_CONF" 2>/dev/null
fi

# Live-reload neovim instances via nvim --server
if [ "$target" = "light" ]; then
    nvim_scheme="washi"
    nvim_bg="light"
else
    nvim_scheme="kanagawa-dragon"
    nvim_bg="dark"
fi
for sock in /tmp/nvim.*/0 /run/user/*/nvim.*/0 "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*/0; do
    [ -S "$sock" ] && nvim --server "$sock" --remote-send "<Cmd>set background=${nvim_bg}<CR><Cmd>colorscheme ${nvim_scheme}<CR>" 2>/dev/null &
done
wait 2>/dev/null

# Update pi theme
if [ -f "$PI_SETTINGS" ]; then
    if [ "$target" = "light" ]; then
        sed -i '' 's/"theme": "washi-dark"/"theme": "washi-light"/' "$PI_SETTINGS"
    else
        sed -i '' 's/"theme": "washi-light"/"theme": "washi-dark"/' "$PI_SETTINGS"
    fi
fi

# Save state
echo "$target" > "$STATE_FILE"
echo "Switched to $target mode ✓"
